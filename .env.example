# Smart Bangla Voice Keyboard — example configuration
# Copy to .env and fill locally. NEVER commit the filled file.

# Google Gemini API key (personal / direct-use only).
# Direct on-device keys are visible to the user of the binary.
# For production, use an authenticated backend proxy (see docs/adr/ADR-004-api-key-config.md).
GEMINI_API_KEY=

# Optional backend proxy base URL (HTTPS only). Leave blank for direct personal use.
GEMINI_PROXY_URL=

# Optional model overrides. Verify current IDs against official docs before setting.
GEMINI_TEXT_MODEL=
GEMINI_AUDIO_MODEL=
GEMINI_LIVE_MODEL=
GEMINI_TTS_MODEL=

# Logging: never set to true in production; may include request metadata.
DEBUG_LOG=false
