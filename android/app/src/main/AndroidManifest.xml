<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Voice capture requires this permission; it is only requested after the
         in-keyboard consent gate is accepted. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Only used by the explicit "Test connection" action in the setup screen.
         Offline typing never needs or uses the network. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application android:label="@string/app_name" android:theme="@style/AppTheme">
        <!-- Launcher / setup screen: an IME alone has no app icon, so without
             this activity the installed app appears hidden and cannot be opened. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Real system-wide input method. BIND_INPUT_METHOD is enforced by Android. -->
        <service
            android:name=".BanglaVoiceIme"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method" />
        </service>

        <!-- Transparent permission broker: only started after explicit consent. -->
        <activity
            android:name=".VoicePermissionActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
