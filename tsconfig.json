{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": ["shared/**/*.ts", "tests/**/*.ts", "android/**/*.ts", "windows/**/*.ts", "macos/**/*.ts"]
}
